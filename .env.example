# hy4-predict environment config
# Copy to .env and fill in your values before running locally.
# On Railway: set these in the Railway dashboard (Variables tab).

# Base64-encoded PKCS8 wallet JSON — signs faucet + bet transactions.
# Generate with: vara-wallet wallet export <name> | base64
FUNDER_WALLET_JSON=<base64-encoded-pkcs8-wallet-json>

# On-chain program IDs (do not change unless you redeploy the contracts)
PROGRAM_ID_V1=0x2aa206e02547b2c23751e112c0751acb463d80756c34477f12db89fa1fe877e6
PROGRAM_ID_V2=0xd24f2886dcb29dec16fc53214b7c8e498b2e96ea55d31a1497571e1ae15f5271

# HTTP server port (Railway sets this automatically via $PORT)
PORT=3001

# VARA to send each new agent wallet on registration
FAUCET_AMOUNT_VARA=10

# Admin key for protected endpoints
ADMIN_KEY=change-me

# (Optional) Groq API key — only needed for reach_out.py agent outreach
GROQ_API_KEY=
